# Optional. When set, the contact form POSTs to this URL (form-encoded) the same
# way the support form posts to its LeadConnector webhook. When unset, the
# contact form falls back to opening the visitor's email client with the
# message pre-filled.
VITE_CONTACT_WEBHOOK_URL=

# Optional. Override the support-ticket webhook (defaults to the existing
# LeadConnector hook in src/lib/site.ts).
VITE_SUPPORT_WEBHOOK_URL=
